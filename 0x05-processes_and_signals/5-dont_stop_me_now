#!/bin/bash
!/usr/bin/env bash
# This script finds the PID of the '4-to_infinity_and_beyond' script and terminates it using the kill command.

# Find the PID of the target script using pgrep, as it is the most robust tool for this purpose.
# pgrep -f searches the full command line, not just the command name.
# The `|| true` prevents the script from exiting if the process is not found.

TARGET_PID=$(pgrep -f "4-to_infinity_and_beyond")

# Check if a PID was actually found before attempting to kill
if [ -n "$TARGET_PID" ]; then
    
    # Use the kill command with signal 15 (SIGTERM - default and graceful termination)
    # The PID is retrieved using command substitution
    kill "$TARGET_PID"
    echo "Terminated process with PID: $TARGET_PID"
    
else
    echo "Process '4-to_infinity_and_beyond' not found."
fi
