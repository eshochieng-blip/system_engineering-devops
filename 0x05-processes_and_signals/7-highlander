#!/bin/bash
#!/usr/bin/env bash
# A script that displays "To infinity and beyond" indefinitely
# and reacts to SIGTERM with "I am invincible!!!"

# The trap command catches SIGTERM (signal 15)
# and executes the echo command instead of exiting.
trap 'echo "I am invincible!!!"' SIGTERM

while true
do
    echo "To infinity and beyond"
    sleep 2
done
