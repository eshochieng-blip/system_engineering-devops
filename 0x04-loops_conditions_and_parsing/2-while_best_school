#!/bin/bash
#!/usr/bin/env bash
# This script uses a while loop to print the phrase "Best School" exactly 10 times.

# Initialize a counter variable
count=1

# Start the while loop. The loop continues as long as 'count' is less than or equal to 10.
while [ "$count" -le 10 ]; do
    # Print the required phrase
    echo "Best School"
    
    # Increment the counter for the next iteration
    count=$((count + 1))
done
