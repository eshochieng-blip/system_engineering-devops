#!/bin/bash
#!/usr/bin/env bash
# This script uses an until loop to print the phrase "Best School" exactly 10 times.

# Initialize a counter variable
count=1

# Start the until loop. The loop continues UNTIL 'count' is GREATER THAN 10.
until [ "$count" -gt 10 ]; do
    # Print the required phrase
    echo "Best School"
    
    # Increment the counter for the next iteration
    count=$((count + 1))
done
